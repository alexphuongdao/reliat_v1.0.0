# Reliat — root env for `docker compose up`. Copy to `.env` and fill in.

# console.anthropic.com — used by the Diagnostic Agent (services/api).
ANTHROPIC_API_KEY=sk-ant-...

# Local Postgres password (dev only — compose creates the DB with this).
POSTGRES_PASSWORD=reliat_dev_password

# --- Auth ---------------------------------------------------------------
# Signs the short-lived OAuth state cookie. Generate with:
#   openssl rand -base64 32
RELIAT_SESSION_SECRET=reliat_dev_session_secret

# Demo profile passwords, applied only when the profile is first created.
# Changing these later does NOT reset an existing user's password.
RELIAT_SEED_CEMEX_PASSWORD=Cemex-Reliat-2026!
RELIAT_SEED_ADMIN_PASSWORD=Admin-Reliat-2026!

# --- OAuth (optional) ---------------------------------------------------
# Leave blank and the provider simply isn't offered on the login page.
# Redirect URI to register with the provider:
#   http://localhost:8000/api/auth/oauth/<provider>/callback
RELIAT_OAUTH_GOOGLE_CLIENT_ID=
RELIAT_OAUTH_GOOGLE_CLIENT_SECRET=
RELIAT_OAUTH_MICROSOFT_CLIENT_ID=
RELIAT_OAUTH_MICROSOFT_CLIENT_SECRET=
# Entra ID directory: a tenant GUID, or "organizations" / "common".
RELIAT_OAUTH_MICROSOFT_TENANT=common
